# Copy to .env.local (never commit it). All values below are placeholders.

# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string, "Session pooler").
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Public base URL of the web app (used in emails and links).
APP_BASE_URL=http://localhost:3000

# Set to "true" only in production behind HTTPS (marks session cookies Secure).
COOKIE_SECURE=false

# --- Phase 3: AI extraction (OFF until the owner approves the cost) ---
AI_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Hard monthly AI spend cap in USD; extraction is skipped (never partially applied) when it would be exceeded.
AI_MONTHLY_BUDGET_USD=0

# --- Phase 5: email notifications (leave empty until approved) ---
RESEND_API_KEY=
EMAIL_FROM=

# Contact address sent in the User-Agent of the source monitor so site operators can reach us.
MONITOR_CONTACT_EMAIL=

# Set to "true" ONLY when deployed behind a proxy that overwrites X-Forwarded-For / X-Real-IP (enables per-IP login limits).
TRUST_PROXY=false

# --- Private live preview (15 Oct 2026) ---
# When set, every page asks for this password (any user name) and is hidden from search engines. Leave empty locally.
SITE_PASSWORD=
